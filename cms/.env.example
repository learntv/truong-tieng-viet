DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 — uploaded media storage. Only read when NODE_ENV=production; local dev
# writes uploads to cms/media on disk and needs none of these. When it is production and any
# of them is missing, the server refuses to boot and names the ones it wants.
#
# Same variable names the app uses for the same bucket (see the root .env.example) — one R2
# block works for both. The S3 endpoint is derived from the account id, so there is nothing
# to configure for it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=truong-tieng-viet
# Public hostname the bucket is served from (r2.dev URL or a custom domain), no trailing slash.
# Without it Payload would serve media back through its own /api/media/file route instead of
# straight from the CDN.
R2_PUBLIC_BASE_URL=https://media.example.com
