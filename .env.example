# Supabase (already required by the app — see src/integrations/supabase/client*.ts).
# scripts/generate-audio.ts reads bai rows with the plain public client below — the TTS
# pipeline never writes to Supabase, so no service-role key is needed for it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Google Cloud Text-to-Speech — API key. In the Cloud Console, restrict it to the "Cloud
# Text-to-Speech API" only (API restrictions) so a leak can't be used against other Google
# APIs on the project. It's used server-only (src/lib/tts/synthesize.server.ts) and never
# reaches the client bundle.
GOOGLE_TTS_API_KEY=

# Cloudflare R2 — writes (upload/delete) go through the S3-compatible API token below; the
# bucket itself is public for reads, so /api/tts redirects browsers straight to R2 instead
# of proxying audio bytes through the Worker. Create the API token under R2 > Manage API
# Tokens in the Cloudflare dashboard.
#
# The CMS reads these same five for its own uploads (cms/src/payload.config.ts) and shares the
# bucket: TTS owns audio/, the CMS owns media/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public base URL (R2.dev subdomain or a custom domain you've mapped to it),
# no trailing slash — e.g. https://pub-xxxxxxxx.r2.dev or https://audio.yourapp.com
R2_PUBLIC_BASE_URL=

# Payload CMS (cms/ workspace) — the app reads all editable content from its public REST API:
# the learning tree (src/lib/learning.ts) and speaking practice (src/hooks/useSpeakingContent.ts).
# Origin only, no trailing slash; locally the CMS dev server runs on http://localhost:3001
# (bun run dev:cms). The app can't render lessons without it, and the origin the app is served
# from has to be in the CMS's `cors` list (cms/src/payload.config.ts).
VITE_CMS_URL=
