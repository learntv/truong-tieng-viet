{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start-lovable",
      "bindings": [{ "type": "service", "service": "cms", "format": "url", "env": "CMS_URL" }]
    },
    "cms": {
      "root": "cms",
      "framework": "nextjs",
      "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then bun run migrate; fi && bun run build"
    }
  },
  "rewrites": [
    { "source": "/api/tts", "destination": { "service": "app" } },
    { "source": "/api/tts/(.*)", "destination": { "service": "app" } },
    { "source": "/api/avatar", "destination": { "service": "app" } },
    { "source": "/api/avatar/(.*)", "destination": { "service": "app" } },
    { "source": "/api/(.*)", "destination": { "service": "cms" } },
    { "source": "/admin", "destination": { "service": "cms" } },
    { "source": "/admin/(.*)", "destination": { "service": "cms" } },
    { "source": "/_next/(.*)", "destination": { "service": "cms" } },
    { "source": "/brand/(.*)", "destination": { "service": "cms" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
